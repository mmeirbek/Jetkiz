// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  CARRIER
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  NEW
  SEARCHING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  AT_CHECKPOINT
  DELIVERED
  CANCELLED
}

enum DeviceStatus {
  ACTIVE
  SUSPENDED
  RETIRED
}

enum Metric {
  TEMPERATURE
  HUMIDITY
  BATTERY
  SPEED
}

enum RuleOperator {
  GT
  GTE
  LT
  LTE
}

enum Severity {
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole

  firstName String
  lastName  String
  phone     String

  avatarUrl String?

  companyName String?
  companyLogo String?

  city    String?
  country String?

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  refreshTokens  RefreshToken[]
  carrierProfile CarrierProfile?
  orders         Order[]         @relation("ClientOrders")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model CarrierProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  experienceYears Int
  transportType   String
  description     String?
  isApproved      Boolean  @default(false)
  rating          Float?
  completedOrders Int      @default(0)
  webhookUrl      String?
  webhookSecret   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  vehicles Vehicle[]
  orders   Order[]

  @@index([isApproved])
  @@index([transportType])
}

model Vehicle {
  id              String   @id @default(cuid())
  carrierId       String
  type            String
  brand           String
  model           String
  year            Int
  plateNumber     String
  capacityTons    Float
  cargoVolume     Float
  vehicleImageUrl String?
  lastLat         Float?
  lastLng         Float?
  lastSeenAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  carrier CarrierProfile @relation(fields: [carrierId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  device  Device?
  alerts  SensorAlert[]

  @@unique([carrierId, plateNumber])
  @@index([carrierId])
  @@index([type])
}

model Order {
  id                         String      @id @default(cuid())
  clientId                   String
  carrierId                  String?
  title                      String
  cargoType                  String
  weight                     Float
  volume                     Float
  origin                     String
  originSettlementId         String?
  originCity                 String?
  originCountry              String?
  destination                String
  destinationSettlementId    String?
  destinationCity            String?
  destinationCountry         String?
  originLat                  Float?
  originLng                  Float?
  destinationLat             Float?
  destinationLng             Float?
  cargoPhotoUrl              String?
  productPhotoUrls           String[]    @default([])
  comment                    String?
  estimatedPrice             Float?
  estimatedDeliveryTime      Int?
  estimatedCarrierSearchTime Int?
  assignedVehicleId          String?
  tempMin                    Float?
  tempMax                    Float?
  isReefer                   Boolean     @default(false)
  status                     OrderStatus @default(SEARCHING)
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  client         User            @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  carrier        CarrierProfile? @relation(fields: [carrierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  originSettlement Settlement? @relation("OriginSettlementOrders", fields: [originSettlementId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  destinationSettlement Settlement? @relation("DestinationSettlementOrders", fields: [destinationSettlementId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  routes         Route[]
  trackingEvents OrderTracking[]
  alerts         SensorAlert[]
  cameraSnapshots CameraSnapshot[]

  @@index([clientId])
  @@index([carrierId])
  @@index([assignedVehicleId])
  @@index([originSettlementId])
  @@index([destinationSettlementId])
  @@index([status])
  @@index([createdAt])
}

model CameraSnapshot {
  id         String   @id @default(cuid())
  deviceId   String
  vehicleId  String?
  orderId    String?
  url        String
  capturedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([deviceId, capturedAt])
  @@index([vehicleId, capturedAt])
  @@index([orderId, capturedAt])
}

model Route {
  id              String   @id @default(cuid())
  orderId         String?
  distanceKm      Float
  durationMinutes Float
  geometry        Json
  createdAt       DateTime @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model Settlement {
  id        String   @id
  name      String   @unique
  nameRu    String
  nameKk    String
  type      String
  district  String
  latitude  Float
  longitude Float
  source    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  originOrders      Order[] @relation("OriginSettlementOrders")
  destinationOrders Order[] @relation("DestinationSettlementOrders")

  @@index([district])
  @@index([latitude, longitude])
}

model Checkpoint {
  id             String   @id @default(cuid())
  name           String   @unique
  loadPercent    Int      @default(0)
  avgWaitMinutes Int      @default(0)
  latitude       Float
  longitude      Float
  updatedAt      DateTime @updatedAt

  @@index([latitude, longitude])
}

model TrainSchedule {
  id               String   @id @default(cuid())
  stationName      String   @unique
  departuresPerDay Int      @default(0)
  currentLoad      Int      @default(0)
  avgDelayMinutes  Int      @default(0)
  latitude         Float
  longitude        Float
  updatedAt        DateTime @updatedAt

  @@index([latitude, longitude])
}

model CheckpointLoadSnapshot {
  id                String   @id @default(cuid())
  syncBatchId       String
  source            String
  checkpointName    String
  borderCountry     String?
  region            String?
  waitingAreaCount  Int      @default(0)
  activeTruckNumbers String[] @default([])
  entryTimes        String[] @default([])
  raw               Json
  fetchedAt         DateTime @default(now())

  @@index([syncBatchId])
  @@index([fetchedAt])
  @@index([checkpointName])
}

model OrderTracking {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  location  String?
  timestamp DateTime    @default(now())
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([timestamp])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Device {
  id         String       @id @default(cuid())
  name       String
  secretHash String
  status     DeviceStatus @default(ACTIVE)
  vehicleId  String?      @unique
  lastLat    Float?
  lastLng    Float?
  lastSeenAt DateTime?
  createdAt  DateTime     @default(now())

  vehicle   Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  telemetry TelemetryRecord[]
  rules     SensorRule[]
  alerts    SensorAlert[]
  cameraSnapshots CameraSnapshot[]

  @@index([status])
  @@index([lastSeenAt])
}

model TelemetryRecord {
  id          String   @id @default(cuid())
  deviceId    String
  vehicleId   String?
  orderId     String?
  temperature Float?
  humidity    Float?
  battery     Float?
  speedKmh    Float?
  lat         Float
  lng         Float
  eventTime   DateTime @default(now())
  raw         Json
  createdAt   DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([deviceId, eventTime])
  @@index([vehicleId, eventTime])
  @@index([orderId, eventTime])
}

model SensorRule {
  id        String       @id @default(cuid())
  deviceId  String?
  metric    Metric
  operator  RuleOperator
  threshold Float
  severity  Severity     @default(WARNING)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  alerts SensorAlert[]

  @@index([deviceId])
  @@index([isActive])
}

model SensorAlert {
  id              String      @id @default(cuid())
  deviceId        String
  vehicleId       String?
  orderId         String?
  ruleId          String?
  metric          Metric
  value           Float
  severity        Severity
  message         String
  status          AlertStatus @default(OPEN)
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  createdAt       DateTime    @default(now())

  device Device     @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rule   SensorRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  order   Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([deviceId])
  @@index([status, createdAt])
  @@index([vehicleId])
  @@index([orderId])
}
